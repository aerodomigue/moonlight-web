# Self-hosted fork. The default profile does not contact MoonlightWeb services.
# Copy to .env beside the executable, or pass these variables to the container.
MW_REVERSE_PROXY=1
MW_NO_TELEMETRY=1

# Your HTTPS origin, configurable at runtime. No subpath, credentials or fragment.
MW_PUBLIC_URL=https://moonlight.example.com

# Actual socket peers of the proxy (comma-separated IPs or CIDRs).
# Trust only your own proxy; never use 0.0.0.0/0 or ::/0.
MW_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Container entrypoint listener overrides (avoid conflicts with the proxy).
MW_HTTP_PORT=8080
MW_HTTPS_PORT=8443
